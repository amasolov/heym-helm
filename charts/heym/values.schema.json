{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "platform": {
      "type": "string",
      "enum": [
        "generic",
        "openshift",
        "eks",
        "aks",
        "gke"
      ]
    },
    "cni": {
      "type": "string",
      "description": "Only cilium changes anything today; leave empty for other CNIs.",
      "enum": [
        "",
        "cilium"
      ]
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "annotations": {
      "type": "object"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "",
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "secretKey": {
          "type": "string"
        },
        "encryptionKey": {
          "type": "string"
        },
        "databaseUrl": {
          "type": "string"
        },
        "existingSecrets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generate": {
          "type": "boolean"
        },
        "keyRefs": {
          "type": "object",
          "properties": {
            "SECRET_KEY": {
              "type": "object",
              "required": [
                "name",
                "key"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "ENCRYPTION_KEY": {
              "type": "object",
              "required": [
                "name",
                "key"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "DATABASE_URL": {
              "type": "object",
              "required": [
                "name",
                "key"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "workers": {
      "type": "integer",
      "minimum": 1
    },
    "persistence": {
      "type": "object",
      "properties": {
        "existingClaim": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ReadWriteOnce",
              "ReadWriteMany"
            ]
          },
          "minItems": 1
        },
        "size": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        }
      }
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "podOverrides": {
          "type": "object",
          "description": "Only these keys: Heym disables its Kubernetes backend on any other.",
          "properties": {
            "nodeSelector": {
              "type": "object"
            },
            "tolerations": {
              "type": "array"
            },
            "runtimeClassName": {
              "type": "string"
            },
            "imagePullSecrets": {
              "type": "array"
            },
            "priorityClassName": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "networkPolicy": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "exceptCIDRs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "extraExceptCIDRs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowAllEgress": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowInternet": {
          "type": "boolean"
        },
        "apiServerCIDRs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ingressFrom": {
          "type": "array"
        },
        "extraEgress": {
          "type": "array"
        }
      }
    },
    "ciliumApiServerPolicy": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "route": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "selectorLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extraPorts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "envFrom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "workingDir": {
      "type": "string"
    },
    "service": {
      "type": "object",
      "properties": {
        "portName": {
          "type": "string",
          "minLength": 1
        },
        "extraPorts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "cluster": {
      "type": "object",
      "description": "Load-distribution workers: a StatefulSet that takes queued runs. The UI, API and main-only workflows stay on the backend.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "processes": {
          "type": "integer",
          "minimum": 1
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "description": "Worker-only environment, merged over env."
        },
        "resources": {
          "type": "object"
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "ReadWriteOnce",
                  "ReadWriteMany"
                ]
              }
            }
          }
        },
        "spreadAcrossNodes": {
          "type": "boolean"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workingDir": {
          "type": "string"
        },
        "extraVolumes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraVolumeMounts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
