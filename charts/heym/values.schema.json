{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "platform": {
      "type": "string",
      "enum": ["generic", "openshift", "eks", "aks", "gke"]
    },
    "cni": {
      "type": "string",
      "description": "Only cilium changes anything today; leave empty for other CNIs.",
      "enum": ["", "cilium"]
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "url": { "type": "string", "pattern": "^https?://" },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "secretKey": { "type": "string" },
        "encryptionKey": { "type": "string" },
        "databaseUrl": { "type": "string" }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "workers": { "type": "integer", "minimum": 1 },
    "persistence": {
      "type": "object",
      "properties": {
        "existingClaim": { "type": "string" },
        "accessModes": {
          "type": "array",
          "items": { "type": "string", "enum": ["ReadWriteOnce", "ReadWriteMany"] },
          "minItems": 1
        },
        "size": { "type": "string" },
        "storageClass": { "type": "string" }
      }
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "podOverrides": {
          "type": "object",
          "description": "Only these keys: Heym disables its Kubernetes backend on any other.",
          "properties": {
            "nodeSelector": { "type": "object" },
            "tolerations": { "type": "array" },
            "runtimeClassName": { "type": "string" },
            "imagePullSecrets": { "type": "array" },
            "priorityClassName": { "type": "string" }
          },
          "additionalProperties": false
        },
        "networkPolicy": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" },
            "exceptCIDRs": { "type": "array", "items": { "type": "string" } },
            "extraExceptCIDRs": { "type": "array", "items": { "type": "string" } },
            "allowAllEgress": { "type": ["boolean", "null"] }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "allowInternet": { "type": "boolean" },
        "apiServerCIDRs": { "type": "array", "items": { "type": "string" } },
        "ingressFrom": { "type": "array" },
        "extraEgress": { "type": "array" }
      }
    },
    "ciliumApiServerPolicy": { "type": ["boolean", "null"] },
    "route": {
      "type": "object",
      "properties": { "enabled": { "type": ["boolean", "null"] } }
    }
  }
}
